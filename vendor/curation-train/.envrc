# UV cache (isolated per package, uses machine-aware base from bashrc)
export UV_CACHE_DIR="${UV_CACHE_BASE:?Set UV_CACHE_BASE in your environment}/DataAgent-train"
export UV_LINK_MODE="copy"

# PyTorch CUDA version — set TORCH_CUDA per machine (used by pyproject.toml index URL).
TORCH_CUDA="${TORCH_CUDA:?Set TORCH_CUDA (e.g. cu124, cu128) in your environment}"

# Triton cache off NFS to avoid hangs on exit
export TRITON_CACHE_DIR="${UV_CACHE_BASE}/triton"

mkdir -p "$UV_CACHE_DIR" "$TRITON_CACHE_DIR"
