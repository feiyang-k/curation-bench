# UV cache (isolated per package, uses machine-aware base from bashrc)
export UV_CACHE_DIR="${UV_CACHE_BASE:?Set UV_CACHE_BASE in your environment}/DataAgent-vlmeval"
export UV_LINK_MODE="copy"

# PyTorch CUDA wheel index (cu128 = CUDA 12.8)
export TORCH_CUDA="cu128"

# CUDA toolkit
if [ -z "${CUDA_HOME:-}" ]; then
    if type module &>/dev/null; then
        module load CUDA/12.8.0 2>/dev/null || true
    fi
fi

# Triton cache off NFS
export TRITON_CACHE_DIR="${UV_CACHE_BASE}/triton"

mkdir -p "$UV_CACHE_DIR" "$TRITON_CACHE_DIR"
